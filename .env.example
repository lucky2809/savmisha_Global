# Copy this file to .env and restart the dev server.
# Vite only exposes variables prefixed with VITE_.

# Backend API root. Must include the /api prefix - every route is mounted there,
# and image paths from the API ("/uploads/x.jpg") are appended to this value.
VITE_API_URL=https://api.savmishaglobal.com/api

# Local development against a backend on port 8000:
# VITE_API_URL=http://localhost:8000/api

# Cart endpoints (not implemented on the backend yet)
VITE_BACK_END_URL=https://api.savmishaglobal.com/api

# Contact / social details rendered in the navbar, footer and contact page
VITE_APP_CONTACT_EMAIL=info@savmishaglobal.com
VITE_APP_INSTAGRAM_LINK=https://www.instagram.com/savmishaglobal
VITE_PHONE_NUMBER=+910000000000

# Floating WhatsApp widget
VITE_WHATSAPPNO=910000000000
VITE_WHATSAPPNAME=Savmisha Global
